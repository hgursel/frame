{
  "name": "@frame-workspace/frame",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "A self-hosted organizational AI workspace powered by local llama.cpp models.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node --import tsx tests/browser.smoke.ts && node --import tsx tests/mssql.browser.ts",
    "check": "tsc --noEmit",
    "python:setup": "node --env-file-if-exists=.env --import tsx server/setup-python.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.4",
    "fflate": "0.8.3",
    "mermaid": "12.0.0",
    "node-sql-parser": "5.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tedious": "20.0.0",
    "typebox": "1.3.30",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
