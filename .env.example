# Optional deployment settings. Model settings belong in the web interface.
FRAME_HOST=127.0.0.1
FRAME_PORT=3000
FRAME_ORIGIN=http://127.0.0.1:3000
FRAME_DATA_DIR=./data
# Optional first-run token. When omitted, a random token is printed on startup.
# FRAME_SETUP_TOKEN=replace-with-a-long-random-value
# Optional externally managed Python. Otherwise install document tools in Settings.
# FRAME_PYTHON=/opt/frame-python/bin/python

# Optional direct LAN access (replace 192.168.1.50 with this server's LAN IPv4).
# FRAME_HOST=0.0.0.0
# FRAME_ORIGIN=http://192.168.1.50:3000
# FRAME_ALLOW_HTTP_LAN=true
# HTTP is unencrypted; use only on a trusted LAN, or use the HTTPS proxy guide.
